<?xml version="1.0" encoding="utf-8"?>
<!-- 안드로이드 8.1(API 27) 이상: 아래쪽 내비게이션 막대 아이콘도 밝은 배경용(어두운 아이콘)으로 -->
<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:statusBarColor">@color/bar_bg</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
