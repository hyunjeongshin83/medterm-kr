mt:brandName a owl:DatatypeProperty ;
    rdfs:label "상품명"@ko ;
    rdfs:domain mt:AMP ;
    rdfs:range xsd:string .

mt:doseForm a owl:DatatypeProperty ;
    rdfs:label "제형(RxNorm 영문)"@ko ;
    rdfs:domain mt:VMP ;
    rdfs:range xsd:string .

mt:hasATC a owl:ObjectProperty ;
    rdfs:label "ATC 코드"@ko ;
    rdfs:domain mt:VTM ;
    rdfs:range mt:ATCClass .

mt:hasIngredient a owl:ObjectProperty ;
    rdfs:label "성분(VTM)을 가짐"@ko ;
    rdfs:domain mt:VMP ;
    rdfs:range mt:VTM .

mt:isInstanceOfVMP a owl:ObjectProperty ;
    rdfs:label "해당 VMP의 실제 제품임"@ko ;
    rdfs:domain mt:AMP ;
    rdfs:range mt:VMP .

